generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cake {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  emoji       String   @default("🎂")
  imageUrl    String?

  orderItems  OrderItem[]
  recipe      Recipe?
}

model Order {
  id           Int      @id @default(autoincrement())
  customerName String
  phone        String

  items        OrderItem[]

  notes        String?
  pickupDate   DateTime
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  createdById  Int?
  createdBy    User?    @relation("OrderCreatedBy", fields: [createdById], references: [id])
}

model OrderItem {
  id                Int   @id @default(autoincrement())
  orderId           Int
  cakeId            Int
  quantity          Int
  completedQuantity Int   @default(0)

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cake     Cake  @relation(fields: [cakeId], references: [id])

  @@unique([orderId, cakeId])
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String?
  role         String      @default("USER")
  createdAt    DateTime  @default(now())
  sessions     Session[]
  orders       Order[]   @relation("OrderCreatedBy")

  passwordResetTokens PasswordResetToken[]
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Ingredient {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  unit        String   // g, kg, ml, l, pcs
  description String?

  inventory   Inventory?
  recipes     RecipeIngredient[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inventory {
  id                Int      @id @default(autoincrement())
  ingredientId      Int      @unique
  quantity          Float    @default(0)
  lowStockThreshold Float    @default(0)

  ingredient        Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  updatedAt         DateTime @updatedAt
}

model Recipe {
  id          Int      @id @default(autoincrement())
  cakeId      Int      @unique
  name        String
  description String?

  cake        Cake              @relation(fields: [cakeId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RecipeIngredient {
  id           Int   @id @default(autoincrement())
  recipeId     Int
  ingredientId Int
  quantity     Float

  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

